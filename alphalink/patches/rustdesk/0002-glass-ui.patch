diff --git a/flutter/lib/common/glass.dart b/flutter/lib/common/glass.dart
new file mode 100644
index 0000000..67283a0
--- /dev/null
+++ b/flutter/lib/common/glass.dart
@@ -0,0 +1,368 @@
+import 'dart:ui';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_hbb/models/platform_model.dart';
+import 'package:settings_ui/settings_ui.dart';
+
+/// "Glass" interface style (inspired by the translucent, blurred surfaces of
+/// recent iOS): a soft coloured background, frosted panels with a light rim,
+/// floating bars and glass dialogs.
+///
+/// Stored in the local option [kOptionGlassUi]; enabled unless set to `N`.
+const String kOptionGlassUi = 'glass-ui';
+
+bool? _glassOn;
+
+/// Whether the glass style is enabled (cached, see [setGlassOn]).
+bool isGlassOn() {
+  if (_glassOn != null) return _glassOn!;
+  try {
+    _glassOn = bind.mainGetLocalOption(key: kOptionGlassUi) != 'N';
+  } catch (_) {
+    _glassOn = true;
+  }
+  return _glassOn!;
+}
+
+Future<void> setGlassOn(bool on) async {
+  _glassOn = on;
+  try {
+    await bind.mainSetLocalOption(key: kOptionGlassUi, value: on ? 'Y' : 'N');
+  } catch (_) {}
+}
+
+/// Makes scaffolds / app bars / dialog surfaces transparent so that the
+/// glass background and the glass panels show through.
+ThemeData glassifyTheme(ThemeData t) {
+  if (!isGlassOn()) return t;
+  return t.copyWith(
+    scaffoldBackgroundColor: Colors.transparent,
+    appBarTheme: t.appBarTheme.copyWith(
+      backgroundColor: Colors.transparent,
+      elevation: 0,
+      scrolledUnderElevation: 0,
+      surfaceTintColor: Colors.transparent,
+      shadowColor: Colors.transparent,
+    ),
+    dialogTheme: t.dialogTheme.copyWith(
+      backgroundColor: Colors.transparent,
+      elevation: 0,
+    ),
+  );
+}
+
+/// Wraps the whole app (used from `MaterialApp.builder`).
+Widget glassWrap(BuildContext context, Widget? child) {
+  final c = child ?? const SizedBox.shrink();
+  if (!isGlassOn()) return c;
+  return GlassBackground(child: c);
+}
+
+SettingsThemeData glassSettingsTheme(bool dark) {
+  return SettingsThemeData(
+    settingsListBackground: Colors.transparent,
+    settingsSectionBackground:
+        dark ? const Color(0x1FFFFFFF) : const Color(0x99FFFFFF),
+    dividerColor: dark ? const Color(0x22FFFFFF) : const Color(0x22000000),
+  );
+}
+
+/// Soft gradient with a few blurred colour blobs; gives the glass something
+/// to refract.
+class GlassBackground extends StatelessWidget {
+  final Widget child;
+  const GlassBackground({Key? key, required this.child}) : super(key: key);
+
+  @override
+  Widget build(BuildContext context) {
+    final dark = Theme.of(context).brightness == Brightness.dark;
+    final accent = const Color(0xFF5CB888);
+    return Stack(
+      fit: StackFit.expand,
+      children: [
+        DecoratedBox(
+          decoration: BoxDecoration(
+            gradient: LinearGradient(
+              begin: Alignment.topLeft,
+              end: Alignment.bottomRight,
+              colors: dark
+                  ? const [Color(0xFF06140F), Color(0xFF0B1E1A), Color(0xFF0E1216)]
+                  : const [Color(0xFFE6F4EC), Color(0xFFDDEEF0), Color(0xFFF1F3F8)],
+            ),
+          ),
+        ),
+        _Blob(
+            alignment: const Alignment(-1.0, -0.8),
+            size: 460,
+            color: accent.withOpacity(dark ? 0.38 : 0.34)),
+        _Blob(
+            alignment: const Alignment(1.1, -0.15),
+            size: 420,
+            color: const Color(0xFF2EC4B6).withOpacity(dark ? 0.26 : 0.26)),
+        _Blob(
+            alignment: const Alignment(-0.35, 1.05),
+            size: 520,
+            color: const Color(0xFF3A86FF).withOpacity(dark ? 0.22 : 0.20)),
+        child,
+      ],
+    );
+  }
+}
+
+class _Blob extends StatelessWidget {
+  final Alignment alignment;
+  final double size;
+  final Color color;
+  const _Blob(
+      {required this.alignment, required this.size, required this.color});
+
+  @override
+  Widget build(BuildContext context) {
+    return Align(
+      alignment: alignment,
+      child: IgnorePointer(
+        child: Container(
+          width: size,
+          height: size,
+          decoration: BoxDecoration(
+            shape: BoxShape.circle,
+            gradient: RadialGradient(colors: [color, color.withOpacity(0)]),
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+/// A frosted-glass panel: backdrop blur, translucent tint, light rim and a
+/// soft shadow.
+class Glass extends StatelessWidget {
+  final Widget child;
+  final double radius;
+  final double blur;
+  final EdgeInsetsGeometry? margin;
+  final EdgeInsetsGeometry? padding;
+  final bool shadow;
+
+  const Glass({
+    Key? key,
+    required this.child,
+    this.radius = 20,
+    this.blur = 20,
+    this.margin,
+    this.padding,
+    this.shadow = true,
+  }) : super(key: key);
+
+  @override
+  Widget build(BuildContext context) {
+    final dark = Theme.of(context).brightness == Brightness.dark;
+    final r = BorderRadius.circular(radius);
+    Widget panel = ClipRRect(
+      borderRadius: r,
+      child: BackdropFilter(
+        filter: ImageFilter.blur(sigmaX: blur, sigmaY: blur),
+        child: DecoratedBox(
+          decoration: BoxDecoration(
+            borderRadius: r,
+            gradient: LinearGradient(
+              begin: Alignment.topLeft,
+              end: Alignment.bottomRight,
+              colors: dark
+                  ? const [Color(0x2EFFFFFF), Color(0x0DFFFFFF)]
+                  : const [Color(0xB3FFFFFF), Color(0x66FFFFFF)],
+            ),
+            border: Border.all(
+              color: dark ? const Color(0x38FFFFFF) : const Color(0xB3FFFFFF),
+              width: 1,
+            ),
+          ),
+          child: Stack(
+            children: [
+              Padding(padding: padding ?? EdgeInsets.zero, child: child),
+              // specular highlight along the top edge
+              Positioned(
+                top: 0,
+                left: radius,
+                right: radius,
+                height: 1,
+                child: IgnorePointer(
+                  child: DecoratedBox(
+                    decoration: BoxDecoration(
+                      gradient: LinearGradient(colors: [
+                        Colors.white.withOpacity(0),
+                        Colors.white.withOpacity(dark ? 0.55 : 0.95),
+                        Colors.white.withOpacity(0),
+                      ]),
+                    ),
+                  ),
+                ),
+              ),
+            ],
+          ),
+        ),
+      ),
+    );
+    if (shadow) {
+      // The shadow is clipped to the outside of the panel: otherwise it would
+      // show through the translucent glass as a dark band.
+      panel = Stack(
+        clipBehavior: Clip.none,
+        children: [
+          Positioned.fill(
+            child: IgnorePointer(
+              child: ClipPath(
+                clipper: _OutsideRRect(radius),
+                child: DecoratedBox(
+                  decoration: BoxDecoration(
+                    borderRadius: r,
+                    boxShadow: [
+                      BoxShadow(
+                        color: Colors.black.withOpacity(dark ? 0.40 : 0.14),
+                        blurRadius: 28,
+                        offset: const Offset(0, 10),
+                      ),
+                    ],
+                  ),
+                ),
+              ),
+            ),
+          ),
+          panel,
+        ],
+      );
+    }
+    if (margin != null) panel = Padding(padding: margin!, child: panel);
+    return panel;
+  }
+}
+
+class _OutsideRRect extends CustomClipper<Path> {
+  final double radius;
+  const _OutsideRRect(this.radius);
+
+  @override
+  Path getClip(Size size) {
+    return Path.combine(
+      PathOperation.difference,
+      Path()
+        ..addRect(Rect.fromLTWH(-120, -120, size.width + 240, size.height + 240)),
+      Path()
+        ..addRRect(RRect.fromRectAndRadius(
+            Offset.zero & size, Radius.circular(radius))),
+    );
+  }
+
+  @override
+  bool shouldReclip(covariant _OutsideRRect old) => old.radius != radius;
+}
+
+/// A list card: glass when the style is on, a regular [Card] otherwise.
+Widget glassCard(BuildContext context,
+    {required Widget child, EdgeInsets? margin}) {
+  if (!isGlassOn()) {
+    return Card(margin: margin, child: child);
+  }
+  return Glass(
+    radius: 18,
+    blur: 16,
+    margin: (margin ?? EdgeInsets.zero).add(const EdgeInsets.symmetric(vertical: 4)),
+    shadow: false,
+    child: child,
+  );
+}
+
+/// Floating glass capsule around the bottom navigation bar.
+Widget glassBottomBar(BuildContext context, Widget bar) {
+  if (!isGlassOn()) return bar;
+  return SafeArea(
+    top: false,
+    minimum: const EdgeInsets.only(bottom: 8),
+    child: Padding(
+      padding: const EdgeInsets.fromLTRB(16, 0, 16, 4),
+      child: Glass(
+        radius: 30,
+        blur: 28,
+        child: MediaQuery.removePadding(
+          context: context,
+          removeBottom: true,
+          child: bar,
+        ),
+      ),
+    ),
+  );
+}
+
+/// The body of [CustomAlertDialog] in glass mode.
+class GlassDialog extends StatelessWidget {
+  final Widget? title;
+  final EdgeInsetsGeometry titlePadding;
+  final Widget content;
+  final EdgeInsetsGeometry contentPadding;
+  final List<Widget>? actions;
+  final EdgeInsetsGeometry actionsPadding;
+  final double buttonSpacing;
+
+  const GlassDialog({
+    Key? key,
+    this.title,
+    required this.titlePadding,
+    required this.content,
+    required this.contentPadding,
+    this.actions,
+    required this.actionsPadding,
+    required this.buttonSpacing,
+  }) : super(key: key);
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    return Dialog(
+      backgroundColor: Colors.transparent,
+      elevation: 0,
+      insetPadding: const EdgeInsets.symmetric(horizontal: 28, vertical: 24),
+      child: Glass(
+        radius: 28,
+        blur: 30,
+        child: ConstrainedBox(
+          constraints: const BoxConstraints(minWidth: 280),
+          child: IntrinsicWidth(
+            child: SingleChildScrollView(
+              child: Column(
+                mainAxisSize: MainAxisSize.min,
+                crossAxisAlignment: CrossAxisAlignment.stretch,
+                children: [
+                  if (title != null)
+                    Padding(
+                      padding: titlePadding,
+                      child: DefaultTextStyle(
+                        style: theme.textTheme.titleLarge ?? const TextStyle(),
+                        child: title!,
+                      ),
+                    ),
+                  Padding(
+                    padding: contentPadding,
+                    child: DefaultTextStyle(
+                      style: theme.textTheme.titleMedium ?? const TextStyle(),
+                      child: content,
+                    ),
+                  ),
+                  if (actions != null && actions!.isNotEmpty)
+                    Padding(
+                      padding: actionsPadding,
+                      child: OverflowBar(
+                        alignment: MainAxisAlignment.end,
+                        spacing: buttonSpacing,
+                        overflowSpacing: buttonSpacing,
+                        children: actions!,
+                      ),
+                    ),
+                ],
+              ),
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
