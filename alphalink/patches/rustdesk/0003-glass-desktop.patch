   }
 }
+
+/// A translucent surface colour for small controls (tab chips, buttons);
+/// falls back to the theme's background when the glass style is off.
+Color glassSurfaceColor(BuildContext context) {
+  if (!isGlassOn()) return Theme.of(context).colorScheme.background;
+  final dark = Theme.of(context).brightness == Brightness.dark;
+  return dark ? const Color(0x1FFFFFFF) : const Color(0x80FFFFFF);
+}
+
+/// Transparent in glass mode (the glass background shows through), the
+/// theme's background otherwise.
+Color glassBaseColor(BuildContext context) {
+  return isGlassOn()
+      ? Colors.transparent
+      : Theme.of(context).colorScheme.background;
+}
+
+/// A full-height frosted side panel (desktop sidebar).
+class GlassPane extends StatelessWidget {
+  final double? width;
+  final Widget child;
+  final Color? fallbackColor;
+  const GlassPane({Key? key, this.width, required this.child, this.fallbackColor})
+      : super(key: key);
+
+  @override
+  Widget build(BuildContext context) {
+    if (!isGlassOn()) {
+      return Container(width: width, color: fallbackColor, child: child);
+    }
+    final dark = Theme.of(context).brightness == Brightness.dark;
+    return SizedBox(
+      width: width,
+      child: ClipRect(
+        child: BackdropFilter(
+          filter: ImageFilter.blur(sigmaX: 26, sigmaY: 26),
+          child: DecoratedBox(
+            decoration: BoxDecoration(
+              gradient: LinearGradient(
+                begin: Alignment.topCenter,
+                end: Alignment.bottomCenter,
+                colors: dark
+                    ? const [Color(0x26FFFFFF), Color(0x0FFFFFFF)]
+                    : const [Color(0x99FFFFFF), Color(0x59FFFFFF)],
+              ),
+              border: Border(
+                right: BorderSide(
+                  color: dark ? const Color(0x2EFFFFFF) : const Color(0x80FFFFFF),
+                  width: 1,
+                ),
+              ),
+            ),
+            child: child,
+          ),
+        ),
+      ),
+    );
+  }
+}
