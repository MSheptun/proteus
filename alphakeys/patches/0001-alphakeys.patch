diff --git a/app/src/main/java/helium314/keyboard/latin/HapticEngine.kt b/app/src/main/java/helium314/keyboard/latin/HapticEngine.kt
new file mode 100644
index 0000000..413bdb3
--- /dev/null
+++ b/app/src/main/java/helium314/keyboard/latin/HapticEngine.kt
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.latin
+
+import android.os.Build
+import android.os.VibrationEffect
+import android.os.Vibrator
+import helium314.keyboard.event.HapticEvent
+import helium314.keyboard.keyboard.internal.keyboard_parser.floris.KeyCode
+import helium314.keyboard.latin.common.Constants
+
+/**
+ * Original haptic profiles for the keyboard (not derived from any other keyboard's code).
+ *
+ * Every profile maps (event, key code) to one of three strengths. On Android 10+ the strengths use the
+ * platform's predefined tick / click / heavy click effects, which actuators tune per device; older
+ * versions fall back to a short one-shot with amplitude control (Android 8+) or a plain timed buzz.
+ */
+object HapticEngine {
+    const val SYSTEM = "SYSTEM"
+    const val SOFT = "SOFT"
+    const val CRISP = "CRISP"
+    const val HEAVY = "HEAVY"
+    const val ADAPTIVE = "ADAPTIVE"
+    val STYLES = listOf(ADAPTIVE, SOFT, CRISP, HEAVY, SYSTEM)
+
+    private enum class Strength(val predefined: Int, val millis: Long, val amplitude: Int) {
+        // predefined effects need API 29, the constants are inlined at compile time
+        FEATHER(-1, 5, 40), // no predefined effect: a lighter one-shot where the actuator supports amplitudes,
+        TICK(VibrationEffect.EFFECT_TICK, 8, 90),
+        CLICK(VibrationEffect.EFFECT_CLICK, 15, 160),
+        HEAVY(VibrationEffect.EFFECT_HEAVY_CLICK, 26, 255),
+    }
+
+    /** @return true if the style handles the event, false if the system default should be used */
+    fun play(vibrator: Vibrator?, style: String, event: HapticEvent, code: Int): Boolean {
+        if (style == SYSTEM || vibrator == null || !vibrator.hasVibrator()) return false
+        val strength = strengthFor(style, event, code) ?: return false
+        vibrate(vibrator, strength)
+        return true
+    }
+
+    private fun strengthFor(style: String, event: HapticEvent, code: Int): Strength? {
+        val special = code == KeyCode.DELETE || code == Constants.CODE_ENTER || code == Constants.CODE_SPACE
+        return when (event) {
+            HapticEvent.NO_HAPTICS -> null
+            HapticEvent.GESTURE_MOVE, HapticEvent.KEY_REPEAT ->
+                if (style == SOFT) Strength.FEATHER else Strength.TICK
+            HapticEvent.KEY_LONG_PRESS ->
+                if (style == SOFT) Strength.CLICK else Strength.HEAVY
+            HapticEvent.KEY_PRESS -> when (style) {
+                SOFT -> Strength.FEATHER
+                CRISP -> if (special) Strength.CLICK else Strength.TICK
+                HEAVY -> if (special) Strength.HEAVY else Strength.CLICK
+                else -> when (code) { // ADAPTIVE: different feel for different keys
+                    Constants.CODE_SPACE -> Strength.CLICK
+                    KeyCode.DELETE -> Strength.CLICK
+                    Constants.CODE_ENTER -> Strength.HEAVY
+                    else -> Strength.TICK
+                }
+            }
+        }
+    }
+
+    @Suppress("DEPRECATION")
+    private fun vibrate(vibrator: Vibrator, s: Strength) {
+        try {
+            val amplitudes = Build.VERSION.SDK_INT >= Build.VERSION_CODES.O && vibrator.hasAmplitudeControl()
+            when {
+                Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q && s.predefined >= 0 ->
+                    vibrator.vibrate(VibrationEffect.createPredefined(s.predefined))
+                // light one-shot where the actuator supports amplitudes, the weakest predefined effect otherwise
+                Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q && !amplitudes ->
+                    vibrator.vibrate(VibrationEffect.createPredefined(VibrationEffect.EFFECT_TICK))
+                Build.VERSION.SDK_INT >= Build.VERSION_CODES.O -> {
+                    val amp = if (amplitudes) s.amplitude else VibrationEffect.DEFAULT_AMPLITUDE
+                    vibrator.vibrate(VibrationEffect.createOneShot(s.millis, amp))
+                }
+                else -> vibrator.vibrate(s.millis)
+            }
+        } catch (_: Exception) {
+            // vibrator can throw on some vendor ROMs; haptics are never worth a crash
+        }
+    }
+}
