+/// (local ipv4, directed broadcast address) for every usable interface address.
+#[cfg(not(any(target_os = "ios")))]
+fn directed_broadcasts() -> Vec<(Ipv4Addr, Ipv4Addr)> {
+    let mut v = Vec::new();
+    for interface in default_net::get_interfaces() {
+        for ipv4 in &interface.ipv4 {
+            if ipv4.addr.is_loopback() || ipv4.addr.is_link_local() {
+                continue;
+            }
+            let ip = u32::from(ipv4.addr);
+            let mask = u32::from(ipv4.netmask);
+            if mask == 0 || mask == u32::MAX {
+                continue;
+            }
+            v.push((ipv4.addr, Ipv4Addr::from(ip | !mask)));
+        }
+    }
+    v
+}
+
+/// Look up the LAN address of a peer previously found by LAN discovery.
+/// Used to connect directly (without any rendezvous / relay server) when the peer is on the
+/// same network.
+pub fn get_lan_ip_of_peer(id: &str) -> Option<String> {
+    config::LanPeers::load()
+        .peers
+        .iter()
+        .find(|p| p.id == id && p.online)
+        .and_then(|p| {
+            p.ip_mac
+                .keys()
+                .filter_map(|ip| ip.parse::<IpAddr>().ok())
+                .find(|ip| ip.is_ipv4())
+                .map(|ip| ip.to_string())
+        })
+}
