+    // Android filters incoming broadcast/multicast UDP unless a multicast lock is held.
+    // LAN discovery needs it to see other devices on the same network.
+    private var multicastLock: WifiManager.MulticastLock? = null
+
+    private fun acquireMulticastLock() {
+        try {
+            if (multicastLock?.isHeld == true) return
+            val wifi = applicationContext.getSystemService(Context.WIFI_SERVICE) as? WifiManager
+            multicastLock = wifi?.createMulticastLock("rustdesk-lan-discovery")?.apply {
+                setReferenceCounted(false)
+                acquire()
+            }
+        } catch (e: Exception) {
+            Log.w(logTag, "acquire multicast lock failed: $e")
+        }
+    }
+
+    private fun releaseMulticastLock() {
+        try {
+            multicastLock?.takeIf { it.isHeld }?.release()
+        } catch (e: Exception) {
+            Log.w(logTag, "release multicast lock failed: $e")
+        }
+        multicastLock = null
+    }
+
+    override fun onPause() {
+        releaseMulticastLock()
+        super.onPause()
+    }
